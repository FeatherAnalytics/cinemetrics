# Copy to .env and fill in. .env is gitignored.

# TMDB API — https://www.themoviedb.org/settings/api
# Used to enrich films (genres, keywords, runtime, budget, revenue) by id.
TMDB_API_KEY=your_key_here

# OMDb API — https://www.omdbapi.com/apikey.aspx
# Used to enrich films (Metascore, Rotten Tomatoes, IMDb, box office, cast) by imdb id.
OMDB_API_KEY=your_key_here

# Letterboxd username, for the RSS feed the updater reads.
LETTERBOXD_USER=poopascoopa

# Letterboxd session cookie, for downloading the account data export
# (watchlist, likes, lists, full diary — none of which the RSS feed carries).
#
# Sign-in is gated by Cloudflare Turnstile, so this cannot be scripted. Get it
# by hand: sign in at letterboxd.com in a browser, open DevTools > Network,
# load letterboxd.com/data/export/, then copy that request's entire Cookie
# header value onto one line below.
#
# The cookie includes cf_clearance, which Cloudflare binds to the IP *and*
# User-Agent that earned it. So LETTERBOXD_USER_AGENT must be the exact UA of
# the browser you copied the cookie from, and the download should run from the
# same network. Re-copy both when the download starts failing with a redirect.
LETTERBOXD_COOKIE=letterboxd.user=...; letterboxd.user.CURRENT=...; cf_clearance=...
LETTERBOXD_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64; rv:...) Gecko/20100101 Firefox/...

# Cloudflare R2 — used to store ML embeddings for the recommendation engine.
R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_access_key
R2_SECRET_ACCESS_KEY=your_secret_key
R2_BUCKET_NAME=cinemetrics-ml

# R2 public URL for the embeddings bucket (used by the web app).
NEXT_PUBLIC_R2_URL=https://your-r2-public-url.r2.dev
